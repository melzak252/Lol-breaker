BETTING_APP_PORT=8501
BETTING_APP_TAX_RATE=0.12
BETTING_APP_MIN_EV=0.05
BETTING_APP_BANKROLL=100.0

# 7200 = 2h. Use 10800 for a safer 3h interval.
BETTING_SCHEDULER_INTERVAL_SECONDS=7200
BETTING_SCHEDULER_RUN_ON_START=1
BETTING_SCHEDULER_BOOKMAKERS=sts,betclic,superbet,efortuna,betfan,totalbet,lebull

# Optional OddsPapi credential; Compose forwards it only to betting-scheduler.
# Store the real key in the private .env, never in this example or Git.
ODDSPAPI_API_KEY=

POSTGRES_DB=betting
POSTGRES_USER=betting
# Generate a unique secret; Compose refuses to start until this is set.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# BETTING_DATABASE_URL=postgresql+psycopg://betting:betting_local_password@timescaledb:5432/betting

# Host path to a mode-0600 file containing the identity-review API token.
IDENTITY_REVIEW_TOKEN_SECRET_FILE=/data/inzynierka/secrets/identity_review_token
